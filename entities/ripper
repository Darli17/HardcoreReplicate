local function soundhum(sound,volume)
    local cln = sound:Clone()
    cln.Parent = character.HumanoidRootPart
    cln:Play()
    cln.Volume = volume
    Debris:AddItem(cln,6)
end
local function soundhumDest(sound)
    character.HumanoidRootPart:WaitForChild(sound):Destroy()
end

